{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "UCRT64 C/C++: Build active file",
            "type": "cppbuild",
            "command": "/ucrt64/bin/g++", // Use 'g++' for C++, 'gcc' for C
            "args": [
                "-g", // Generate debug information
                "${file}", // The active source file
                "-o", // Specify output file
                "${fileDirname}/${fileBasenameNoExtension}.out", // Output executable path/name
                "-std=c++20", // Example: specify C++ standard
                // Add more flags here, e.g., "-Wall" to treat warnings as errors
            ],
            "options": {
                "cwd": "${fileDirname}" // Working directory for the command
            },
            "problemMatcher": [
                "$gcc" // Use appropriate problem matcher
            ],
            "group": {
                "kind": "build",
                "isDefault": true // Set as the default build task (Ctrl+Shift+B)
            },
            "detail": "Task generated by the C/C++ Extension."
        },
